# =========================
# Base de datos (MySQL)
# =========================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=travelers_db
DB_PORT=3306

# Base de datos para pytest (se borra y recrea en cada test)
DB_TEST_NAME=travelers_test_db

# =========================
# Seguridad (JWT)
# =========================
# Genera una clave con: python -c "import secrets; print(secrets.token_hex(32))"
BACK_KEY=cambia_esta_clave_secreta
BACK_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
VALIDATION_TOKEN_EXPIRE_MINUTES=120
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# =========================
# Correo (SMTP)
# =========================
# Con EMAILS_ENABLED=false los correos solo se registran en la BD (envío simulado)
EMAILS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
SMTP_FROM=tu_correo@gmail.com

# URL del frontend (para los enlaces de verificación y recuperación de contraseña)
FRONTEND_URL=http://localhost:5173

# Orígenes del frontend permitidos por CORS, separados por coma
# Producción: CORS_ORIGINS=https://tudominio.com,https://www.tudominio.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =========================
# Imágenes (S3 + CloudFront): paquetes y fotos de perfil
# =========================
# URL pública de CloudFront. Sin ella las imágenes se devuelven con URL null.
CLOUDFRONT_URL=https://xxxxxxxxxxxx.cloudfront.net

# Bucket detrás de CloudFront. Las fotos de perfil se suben a la carpeta avatars/.
S3_BUCKET=nombre-de-tu-bucket
AWS_REGION=us-east-1

# Credenciales SOLO para desarrollo local (usuario IAM con s3:PutObject y
# s3:DeleteObject sobre arn:aws:s3:::nombre-de-tu-bucket/avatars/*).
# En EC2 no las pongas: asigna un rol IAM a la instancia y boto3 lo usa solo.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# =========================
# Inicio de sesión con Google
# =========================
# Client ID de tipo "Aplicación web" creado en Google Cloud Console.
# Sin esta variable el botón de Google no aparece en el frontend.
# Solo se usa el ID de cliente: el secreto del cliente NO hace falta.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Recordatorios automáticos antes del viaje (revisa cada hora)
REMINDERS_ENABLED=true
